# Existing account. Set these ONLY on the server / in Vercel Environment Variables.
CIRCUITGO_ROOM_ID=
CIRCUITGO_FIREBASE_API_KEY=
CIRCUITGO_PHONE=
CIRCUITGO_PIN=
# Optional alternative to phone + PIN: an existing Firebase refresh token.
CIRCUITGO_REFRESH_TOKEN=
# Optional legitimate App Check token, if the service requires one.
CIRCUITGO_APP_CHECK_TOKEN=
# Local UI preview only. Production always ignores this switch.
CIRCUITGO_DEMO=false

# Optional background alerts. Configure a QStash schedule after deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
